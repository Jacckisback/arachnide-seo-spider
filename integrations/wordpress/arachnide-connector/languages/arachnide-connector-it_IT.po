msgid "All in One SEO Lite does not store SEO data for terms (AIOSEO Pro required)."
msgstr "All in One SEO Lite non salva dati SEO per i termini (serve AIOSEO Pro)."

msgid "All in One SEO could not save: "
msgstr "All in One SEO non ha potuto salvare: "

msgid "All in One SEO models are not available (unsupported AIOSEO version)."
msgstr "I modelli di All in One SEO non sono disponibili (versione di AIOSEO non supportata)."

msgid "Canonical must be an absolute http(s) URL."
msgstr "La canonical deve essere un URL assoluto http(s)."

msgid "Invalid URL."
msgstr "URL non valido."

msgid "Invalid source (the home page cannot be redirected)."
msgstr "Origine non valida (la home page non può essere reindirizzata)."

msgid "Invalid source."
msgstr "Origine non valida."

msgid "No post, page or term matches this URL."
msgstr "Nessun articolo, pagina o termine corrisponde a questo URL."

msgid "Post not found."
msgstr "Contenuto non trovato."

msgid "Redirection has no enabled group: finish the Redirection setup first."
msgstr "Redirection non ha gruppi attivi: completate prima la configurazione di Redirection."

msgid "Redirection: "
msgstr "Redirection: "

msgid "Target must be an absolute http(s) URL."
msgstr "La destinazione deve essere un URL assoluto http(s)."

msgid "Term not found."
msgstr "Termine non trovato."

msgid "Value must be a string or null."
msgstr "Il valore deve essere una stringa o null."

msgid "from and to must be absolute http(s) URLs."
msgstr "from e to devono essere URL assoluti http(s)."

msgid "json_ld must be a JSON object or array."
msgstr "json_ld deve essere un oggetto o un array JSON."

msgid "noindex must be true, false or null."
msgstr "noindex deve essere true, false o null."

msgid "Lets Arachnide SEO Spider read and apply SEO fixes (SEO title, meta description, canonical, noindex, 301 redirects, JSON-LD structured data, internal links) through the REST API, using Yoast SEO, Rank Math, All in One SEO, SEOPress or Redirection when they are active."
msgstr "Permette ad Arachnide SEO Spider di leggere e applicare correzioni SEO (title SEO, meta description, canonical, noindex, reindirizzamenti 301, dati strutturati JSON-LD, link interni) tramite l’API REST, usando Yoast SEO, Rank Math, All in One SEO, SEOPress o Redirection quando sono attivi."
