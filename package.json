{
  "name": "arachnide-seo-spider",
  "version": "2.1.0",
  "description": "Free, open-source technical SEO crawler (Screaming Frog alternative): JavaScript rendering, ~90 SEO checks, action plan, white-label PDF reports, 6 languages, local web UI and CLI.",
  "author": "Thierry Gustin (https://thierrygustin.com)",
  "license": "MIT",
  "homepage": "https://github.com/Jacckisback/arachnide-seo-spider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacckisback/arachnide-seo-spider.git"
  },
  "bugs": {
    "url": "https://github.com/Jacckisback/arachnide-seo-spider/issues"
  },
  "keywords": [
    "seo",
    "crawler",
    "spider",
    "seo-audit",
    "technical-seo",
    "screaming-frog-alternative",
    "sitemap",
    "broken-links",
    "redirects",
    "site-audit",
    "javascript-rendering",
    "seo-report",
    "core-web-vitals",
    "geo"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "arachnide": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "crawl": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "3d-force-graph": "1.80.1",
    "cheerio": "1.0.0",
    "force-graph": "1.52.0",
    "puppeteer-core": "23.11.1"
  }
}
