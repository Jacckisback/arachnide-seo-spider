{
  "name": "arachnide-seo-spider",
  "version": "3.22.0",
  "description": "Free, open-source technical SEO crawler (Screaming Frog alternative) with an MCP server: Claude audits your site and applies the fixes on WordPress, Shopify, Wix, Webflow, Joomla, Drupal, PrestaShop, static sites or any site behind Cloudflare.",
  "author": "Thierry Gustin (https://thierrygustin.com)",
  "license": "MIT",
  "homepage": "https://arachnide-seo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacckisback/arachnide-seo-spider.git"
  },
  "bugs": {
    "url": "https://github.com/Jacckisback/arachnide-seo-spider/issues"
  },
  "keywords": [
    "seo",
    "crawler",
    "spider",
    "seo-audit",
    "technical-seo",
    "screaming-frog-alternative",
    "sitemap",
    "broken-links",
    "redirects",
    "site-audit",
    "javascript-rendering",
    "seo-report",
    "core-web-vitals",
    "geo",
    "mcp",
    "model-context-protocol",
    "claude",
    "wordpress",
    "shopify",
    "ai-seo"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "arachnide": "./src/cli.mjs",
    "arachnide-mcp": "./src/mcp.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "crawl": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "mcp": "node src/mcp.mjs",
    "scheduler": "node src/scheduler.mjs",
    "bench": "node --max-old-space-size=8192 bench/run.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "3d-force-graph": "1.80.1",
    "cheerio": "1.0.0",
    "force-graph": "1.52.0",
    "nodemailer": "7.0.13",
    "puppeteer-core": "23.11.1",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "jsdom": "^26.1.0"
  }
}
